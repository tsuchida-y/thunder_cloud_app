// firestore.rules
//
// v1（今のアプリ 1.0.4）の部分は、2026-10-20 時点で本番に出ているルールと同じ中身にしてある。
// v1 のアプリはログインしないため、users や photos を誰でも読み書きできる状態になっている。
// v2.0 の公開時に v1 の部分を締め直す（docs/入道雲サーチ_決定事項.md の5章）。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ===== v2.0（匿名ログインの uid で本人を確かめる） =====

    // 利用者がアプリから書く情報（位置、見張る場所、設定、FCM トークンなど）
    match /members/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // サーバーだけが書く情報（Plus かどうか、通知の記録）。本人は読むだけ
    match /member_server/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // 「見えた」「見えなかった」の答え。本人が作り、本人だけが読める。あとから書き換えない
    match /reports/{reportId} {
      allow create: if signedIn() &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.seen is bool;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // いまある雲の一覧（サーバーが書く）
    match /clouds/{cloudId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 雲の一覧を最後に作った時刻（ホームの「3分前に空を見ました」）。サーバーが書く
    match /system/jma_nowcast {
      allow read: if signedIn();
      allow write: if false;
    }

    // ===== v1（本番と同じ。v2.0 の公開時に締め直す） =====

    // テスト接続用（一時的）
    match /_test_connection/{document} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow write: if true;
      allow read: if true;
    }

    // weather_cache コレクション（気象データキャッシュ）
    match /weather_cache/{cacheId} {
      allow read: if true;   // 誰でも読み取り可能
      allow write: if false; // Firebase Functionsのみ書き込み可能
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if true;
    }

    match /likes/{likeId} {
      allow read: if true;
      allow write: if true;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if true;
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if true;
    }

    match /debug/{document} {
      allow read, write: if true;
    }

    // その他（system など）は全て拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
