// firestore.rules
//
// v1（今のアプリ 1.0.4）の部分は、2026-10-20 時点で本番に出ているルールと同じ中身にしてある。
// v1 のアプリはログインしないため、users や photos を誰でも読み書きできる状態になっている。
// v2.0 の公開時に v1 の部分を締め直す（docs/入道雲サーチ_決定事項.md の5章）。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // members に書けるフィールドと大きさ（アプリが書くもの＋サーバーが書く fcmTokenInvalidAt）。
    // 巨大なデータを入れて、毎回の読み取りを重くされないための上限
    function validMember(d) {
      return d.keys().hasOnly([
               'createdAt', 'platform', 'settings', 'legacyUserId', 'lastOpenedAt',
               'location', 'locationUpdatedAt', 'places', 'fcmToken', 'fcmTokenUpdatedAt', 'fcmTokenInvalidAt'
             ]) &&
             (!('platform' in d) || (d.platform is string && d.platform.size() <= 20)) &&
             (!('settings' in d) || (d.settings is map && d.settings.size() <= 20)) &&
             (!('legacyUserId' in d) || (d.legacyUserId is string && d.legacyUserId.size() <= 100)) &&
             (!('location' in d) || d.location is map) &&
             (!('places' in d) || (d.places is list && d.places.size() <= 10)) &&
             (!('fcmToken' in d) || d.fcmToken == null || (d.fcmToken is string && d.fcmToken.size() <= 500));
    }

    // 「見えた」「見えなかった」の答えに書けるフィールドと型
    function validReport(d) {
      return d.keys().hasOnly(['uid', 'seen', 'cloudId', 'source', 'bearingDeg', 'distanceKm', 'answeredAt', 'reportedAt']) &&
             (!('cloudId' in d) || d.cloudId == null || (d.cloudId is string && d.cloudId.size() <= 100)) &&
             (!('source' in d) || (d.source is string && d.source.size() <= 30)) &&
             (!('bearingDeg' in d) || d.bearingDeg is number) &&
             (!('distanceKm' in d) || d.distanceKm is number) &&
             (!('answeredAt' in d) || d.answeredAt is timestamp) &&
             (!('reportedAt' in d) || d.reportedAt == request.time);
    }

    // ===== v2.0（匿名ログインの uid で本人を確かめる） =====

    // 利用者がアプリから書く情報（位置、見張る場所、設定、FCM トークンなど）
    match /members/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validMember(request.resource.data);
    }

    // サーバーだけが書く情報（Plus かどうか、通知の記録）。本人は読むだけ
    match /member_server/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // 「見えた」「見えなかった」の答え。本人が作り、本人だけが読める。あとから書き換えない
    match /reports/{reportId} {
      allow create: if signedIn() &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.seen is bool &&
                    validReport(request.resource.data);
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // いまある雲の一覧（サーバーが書く）
    match /clouds/{cloudId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 雲の一覧を最後に作った時刻（ホームの「3分前に空を見ました」）。サーバーが書く
    match /system/jma_nowcast {
      allow read: if signedIn();
      allow write: if false;
    }

    // ホームの「いまの空」用のアメダスの最新の観測（サーバーだけが書く）
    match /system/amedas_latest {
      allow read: if signedIn();
      allow write: if false;
    }

    // ===== v1（本番と同じ。v2.0 の公開時に締め直す） =====

    // テスト接続用（一時的）
    match /_test_connection/{document} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow write: if true;
      allow read: if true;
    }

    // weather_cache コレクション（気象データキャッシュ）
    match /weather_cache/{cacheId} {
      allow read: if true;   // 誰でも読み取り可能
      allow write: if false; // Firebase Functionsのみ書き込み可能
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if true;
    }

    match /likes/{likeId} {
      allow read: if true;
      allow write: if true;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if true;
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if true;
    }

    match /debug/{document} {
      allow read, write: if true;
    }

    // その他（system など）は全て拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
